#!/bin/sh
#MISE description="Create a temporary signing keychain and decode signing credentials"
set -eu
set +x
umask 077

for arg in "$@"; do
  case "$arg" in
    --) ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

: "${PARLA_SIGNING_MODE:?PARLA_SIGNING_MODE is required}"
case "$PARLA_SIGNING_MODE" in
  adhoc) exit 0 ;;
  self-signed) ;;
  *) echo "invalid PARLA_SIGNING_MODE: $PARLA_SIGNING_MODE" >&2; exit 2 ;;
esac

: "${RUNNER_TEMP:?RUNNER_TEMP is required}"
: "${MACOS_SELF_SIGNED_P12:?MACOS_SELF_SIGNED_P12 is required}"
: "${MACOS_SELF_SIGNED_PASSWORD:?MACOS_SELF_SIGNED_PASSWORD is required}"

keychain="$RUNNER_TEMP/parla-signing.keychain-db"
p12="$RUNNER_TEMP/cert.p12"
identity_file="$RUNNER_TEMP/parla-signing-identity"

keychain_password=$(openssl rand -hex 32)

cleanup_partial() {
  rm -f "$p12" "$identity_file"
}
trap cleanup_partial EXIT INT TERM

# Decode and import the self-signed signing certificate.
printf '%s' "$MACOS_SELF_SIGNED_P12" | base64 --decode > "$p12"
chmod 600 "$p12"

security create-keychain -p "$keychain_password" "$keychain"
security set-keychain-settings -lut 21600 "$keychain"
security unlock-keychain -p "$keychain_password" "$keychain"
security import "$p12" -k "$keychain" -P "$MACOS_SELF_SIGNED_PASSWORD" -T /usr/bin/codesign -T /usr/bin/security

if ! fingerprint=$(openssl pkcs12 -in "$p12" -nokeys -passin env:MACOS_SELF_SIGNED_PASSWORD 2>/dev/null | openssl x509 -noout -fingerprint -sha1 2>/dev/null); then
  fingerprint=$(openssl pkcs12 -legacy -in "$p12" -nokeys -passin env:MACOS_SELF_SIGNED_PASSWORD | openssl x509 -noout -fingerprint -sha1)
fi
sha1=$(printf '%s\n' "$fingerprint" | sed -n 's/^[^=]*=//p' | tr -d ':' | tr '[:lower:]' '[:upper:]')
if [ "${#sha1}" -ne 40 ]; then
  echo "could not determine the self-signed certificate SHA-1" >&2
  exit 1
fi
case "$sha1" in
  *[!0-9A-F]*) echo "could not determine the self-signed certificate SHA-1" >&2; exit 1 ;;
esac

rm -f "$p12"
trap - EXIT INT TERM

security set-key-partition-list -S apple-tool:,apple: -s -k "$keychain_password" "$keychain"

# Add to search list (prepend so codesign finds it).
set -- "$keychain"
while IFS= read -r line; do
  [ -n "$line" ] || continue
  set -- "$@" "$line"
done <<EOF
$(security list-keychains -d user | sed 's/^[[:space:]]*//; s/^"//; s/"$//')
EOF
security list-keychains -d user -s "$@"

printf '%s\n' "$sha1" > "$identity_file"
chmod 600 "$identity_file"
