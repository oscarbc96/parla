{
  "name": "parla-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "format": "bun fmt",
    "lint": "bun fmt --check && astro sync && bun check",
    "verify": "bun run lint && astro check && linkinator dist --silent",
    "test": "bun test",
    "check-translations": "bun scripts/check-translations.ts",
    "docs-version": "bun scripts/docs-version.ts",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "t:build": "turbo run build",
    "t:test": "turbo run test",
    "t:lint": "turbo run lint",
    "t:verify": "turbo run verify",
    "t:ci": "turbo run build test lighthouse",
    "t:pages": "turbo run build test --force",
    "t:lighthouse": "turbo run lighthouse",
    "serve": "bun scripts/serve-dist.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fumadocs/astro": "0.3.0",
    "@fumadocs/changelog": "^0.1.0",
    "@lucide/astro": "^1.80.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "cn": "^0.5.2",
    "fumadocs-core": "16.19.7",
    "fumadocs-ui": "16.19.7",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@lhci/cli": "^0.16.1",
    "@types/bun": "^1.4.5",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "linkinator": "^8.1.0",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.4"
}
