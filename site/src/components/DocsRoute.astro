---
import Layout from "@/layouts/Layout.astro";
import { Docs } from "@/components/docs";
import { getStars } from "@/lib/github";
import {
  defaultVersion,
  docsVersions,
  getPageMarkdownUrl,
  getVersionSource,
  hasVersions,
  versionBase,
  versionedDocsPath,
  type DocsVersion,
  type source,
} from "@/lib/source";
import { docsOgKey } from "@/lib/pages";
import { absoluteUrl, ogImageUrl, repoUrl, siteName } from "@/lib/seo";
import { getUi, localePath } from "@/i18n";

interface Props {
  locale: string;
  page: ReturnType<typeof source.getPages>[number];
  /** The docs version of the page; the one served at `/docs/` when omitted. */
  version?: DocsVersion;
}

const { locale, page, version = defaultVersion } = Astro.props;
const versionSource = getVersionSource(version);
const isDefault = version.id === defaultVersion.id;
const { body: Content, toc } = await page.data.load();
const stars = await getStars();
const ui = getUi(locale);
const path = versionedDocsPath(version, page.slugs);
const url = absoluteUrl(locale, path);
const crumbs = [
  { name: siteName, item: absoluteUrl(locale, "/") },
  { name: ui.docsTitle, item: absoluteUrl(locale, `${versionBase(version)}/`) },
  ...(page.slugs.length > 0 ? [{ name: page.data.title, item: url }] : []),
];
const pageTree = await versionSource.serializePageTree(
  versionSource.getPageTree(locale),
);
const ogKey = isDefault ? docsOgKey(page.slugs) : "docs";

// Version switcher and banner: only when snapshots exist. Each entry links to
// the same page of that version, or to its index when the page is absent.
const dv = ui.docsVersions;
const versionHref = (target: DocsVersion) => {
  const exists = getVersionSource(target).getPage(page.slugs, locale);
  return localePath(
    locale,
    versionedDocsPath(target, exists ? page.slugs : []),
  );
};
const versionLinks = hasVersions
  ? docsVersions.map((target) => ({
      id: target.id,
      label: target.unreleased ? dv.unreleased : target.id,
      tag: target.latest ? dv.latest : undefined,
      href: versionHref(target),
      current: target.id === version.id,
    }))
  : undefined;
const searchScope = hasVersions
  ? {
      labels: Object.fromEntries(
        docsVersions.map((target) => [
          target.segment ?? "",
          target.unreleased ? dv.unreleased : target.id,
        ]),
      ),
      searching: dv.searching,
    }
  : undefined;
const banner =
  hasVersions && !isDefault
    ? version.unreleased
      ? { text: dv.nextText, linkText: dv.nextLink, href: versionHref(defaultVersion) }
      : {
          text: dv.oldText.replace("{version}", version.id),
          linkText: dv.oldLink,
          href: versionHref(defaultVersion),
        }
    : undefined;
const githubPath =
  version.id === "next"
    ? `site/content/docs/${encodeURI(page.path)}`
    : `site/content/versions/${version.id}/${encodeURI(page.path)}`;
---

<Layout
  title={`${page.data.title} | Parla`}
  description={page.data.description ?? ""}
  locale={locale}
  path={path}
  ogKey={ogKey}
  noindex={!isDefault}
  ogType="article"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: page.data.title,
      description: page.data.description,
      inLanguage: locale,
      url,
      mainEntityOfPage: url,
      image: ogImageUrl(locale, ogKey),
      isPartOf: { "@type": "WebSite", name: siteName, url: absoluteUrl(locale, "/") },
      publisher: { "@type": "Organization", name: siteName, url: repoUrl },
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((crumb, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: crumb.name,
        item: crumb.item,
      })),
    },
  ]}
>
  <Docs
    client:idle
    pathname={Astro.url.pathname}
    params={Astro.params}
    locale={locale}
    stars={stars}
    tree={pageTree}
    title={page.data.title}
    description={page.data.description}
    toc={toc}
    markdownUrl={getPageMarkdownUrl(page, version)}
    githubUrl={`https://github.com/oscarbc96/parla/blob/main/${githubPath}`}
    versionLinks={versionLinks}
    searchScope={searchScope}
    versionLabel={dv.label}
    versionText={{ search: dv.search, empty: dv.noMatch }}
    banner={banner}
  >
    <Content />
  </Docs>
</Layout>
