---
import Layout from "@/layouts/Layout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { absoluteUrl, siteName } from "@/lib/seo";
import { ChangelogPagination, ChangelogTimeline, UnreleasedSection } from "@/components/changelog";
import { getUi, localePath } from "@/i18n";
import { getStars, getUnreleased } from "@/lib/github";
import type { GitHubChangelogEntry } from "@fumadocs/changelog/github";

interface Props {
  locale: string;
  /** 1-based page number. */
  page: number;
  /** Total number of pages (at least 1). */
  total: number;
  entries: GitHubChangelogEntry[];
}

const { locale, page, total, entries } = Astro.props;
const t = getUi(locale).changelog;
const stars = await getStars();
const unreleased = page === 1 ? await getUnreleased() : undefined;
const labels = {
  dateLocale: t.dateLocale,
  prerelease: t.prerelease,
  newer: t.newer,
  older: t.older,
};
const pagePath = (n: number) => (n === 1 ? "/changelog/" : `/changelog/${n}/`);
const url = (n: number) => localePath(locale, pagePath(n));
---

<Layout
  title={page > 1 ? `${t.title} (${page})` : t.title}
  description={t.description}
  locale={locale}
  path={pagePath(page)}
  ogKey="changelog"
  feed={{ href: localePath(locale, "/changelog/atom.xml"), title: t.title }}
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: siteName, item: absoluteUrl(locale, "/") },
        { "@type": "ListItem", position: 2, name: t.heading, item: absoluteUrl(locale, "/changelog/") },
      ],
    },
  ]}
>
  <SiteHeader locale={locale} path={pagePath(page)} stars={stars} section="changelog" />
  <main class="parla bg-parla-app text-parla-text">
    <div class="mx-auto flex w-full max-w-[1040px] flex-col gap-10 px-5 pt-14 pb-16 sm:px-6 sm:pt-16 sm:pb-24">
      <header>
        <h1 class="text-[clamp(32px,4vw,44px)] leading-[1.1] font-extrabold tracking-[-0.03em]">{t.heading}</h1>
        <p class="mt-2.5 text-base text-parla-muted">{t.notesNote}</p>
      </header>
      {
        unreleased && (
          <UnreleasedSection
            notes={unreleased.notes}
            version={unreleased.version}
            url={unreleased.url}
            labels={t.unreleased}
          />
        )
      }
      {
        entries.length === 0 ? (
          <section
            class="card p-6"
            data-testid="changelog-empty"
          >
            <h2 class="parla-h2">{t.empty}</h2>
            <p class="mt-2 text-sm leading-6 text-parla-muted">{t.emptyText}</p>
          </section>
        ) : (
          <ChangelogTimeline entries={entries} labels={labels} />
        )
      }
      <ChangelogPagination
        newer={page > 1 ? url(page - 1) : undefined}
        older={page < total ? url(page + 1) : undefined}
        labels={labels}
      />
    </div>
  </main>
  <SiteFooter locale={locale} />
</Layout>
