---
interface Props {
  name: string;
  alt: string;
  width: number;
  height: number;
  eager?: boolean;
}

const { name, alt, width, height, eager = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const loading = eager ? "eager" : "lazy";
---

<figure class="parla-shot">
  <img
    class="parla-shot-light"
    src={`${base}/shots/${name}-light.webp`}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
  />
  <img
    class="parla-shot-dark"
    src={`${base}/shots/${name}-dark.webp`}
    alt=""
    width={width}
    height={height}
    loading={loading}
    decoding="async"
  />
</figure>
