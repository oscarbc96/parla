---
import Layout from "@/layouts/Layout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { getUi, localePath, nonDefaultLocales } from "@/i18n";

interface Props {
  locale: string;
  /** Default-locale page only: GitHub Pages serves one 404 for the whole site, so hand over to the visitor's locale. */
  redirect?: boolean;
}

const { locale, redirect = false } = Astro.props;
const ui = getUi(locale);
const t = ui.notFound;
const handover = `var l=${JSON.stringify(nonDefaultLocales.map((code) => [code, localePath(code, "/")]))};for(var i=0;i<l.length;i++)if(location.pathname.indexOf(l[i][1])===0){location.replace(l[i][1]+"404/");break}`;
---

<Layout title={t.title} description={t.description} locale={locale} path="/404/" noindex>
  {redirect && nonDefaultLocales.length > 0 && <script is:inline set:html={handover} />}
  <SiteHeader locale={locale} path="/" />
  <main class="parla bg-parla-app text-parla-text">
    <div class="mx-auto w-full max-w-[1160px] px-5 py-20 sm:px-6 sm:py-24">
      <p class="parla-caps text-parla-signal-text">404</p>
      <h1 class="mt-2.5 text-[clamp(32px,4vw,44px)] leading-[1.1] font-extrabold tracking-[-0.03em]">
        {t.heading}
      </h1>
      <p class="mt-3 max-w-xl text-base leading-[1.65] text-parla-muted">{t.text}</p>
      <p class="mt-6">
        <a class="btn btn-primary btn-lg" href={localePath(locale, "/")}>{t.home}</a>
      </p>
    </div>
  </main>
  <SiteFooter locale={locale} />
</Layout>
