tour-tip = Consell { $tip } de { $total }
tour-close = Tanca la visita guiada
tour-skip = Salta la visita
tour-back = Enrere
tour-next = Següent
tour-done = Fet
tour-sidebar-title = Les teves converses
tour-sidebar-body = Canals, missatges directes i les teves seccions. Les no llegides surten en negreta; plega una secció per endreçar-la.
tour-rail-title = Aquí viuen els teus espais de treball
tour-rail-body =
    { $first ->
        [cap] Canvia amb un clic o afegeix-ne un altre amb el botó de més.
       *[other] Canvia amb { $first } a { $last } o afegeix-ne un altre amb el botó de més.
    }
tour-jump-title = Salta a qualsevol lloc
tour-jump-body =
    { $keys ->
        [cap] Obre el selector ràpid per trobar qualsevol conversa o persona pel nom.
       *[other] Prem { $keys } per trobar qualsevol conversa o persona pel nom.
    }
tour-keys-title = Tot té una drecera
tour-keys-body =
    { $keys ->
        [cap] Obre el full de dreceres per veure totes les tecles. Canvia-les a Paràmetres, Tecles.
       *[other] Prem { $keys } per veure totes les tecles. Canvia-les a Paràmetres, Tecles.
    }

