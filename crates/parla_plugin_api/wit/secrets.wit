/// The plugin's own secrets in the system keychain, namespaced by plugin id.
/// At most 32 keys; keys at most 128 bytes, values at most
/// 4 KB. Settings of type `secret` live here, never in `settings.json`.
interface secrets {
  use types.{error};

  /// Capability: none (own secrets only).
  secret-get: func(key: string) -> result<option<string>, error>;
  /// Capability: none (own secrets only).
  secret-set: func(key: string, value: string) -> result<_, error>;
  /// Capability: none (own secrets only).
  secret-delete: func(key: string) -> result<_, error>;
}
