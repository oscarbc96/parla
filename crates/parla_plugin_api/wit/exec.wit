/// Runs a local program with fixed commands. No shell,
/// no stdin; environment only `HOME`, `PATH`, `LANG`, `USER` and XDG
/// variables; an empty temporary working directory. Limits: 10 s wall
/// clock, 1 MB stdout, 64 KB stderr, 2 concurrent runs and 30 runs per
/// minute; over a limit the run is killed and the call returns `limit`.
interface exec {
  use types.{error};

  record exec-output { exit-code: s32, stdout: list<u8>, stderr: list<u8> }

  /// Capability: `exec`, with `program` (a bare name) granted and `args`
  /// matching one granted shape. At most 32 arguments of 1 KB each.
  run: func(program: string, args: list<string>) -> result<exec-output, error>;
}
